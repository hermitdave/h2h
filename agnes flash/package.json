{
  "name": "agnes-flash-scheduler",
  "version": "1.0.0",
  "description": "Production-grade in-memory task scheduler with priorities, dependency tracking, and cycle detection",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scale": "SCALE_TESTS=1 vitest run --config vitest.scale.config.ts tests/scale.spec.ts",
    "bench": "tsx examples/benchmark.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  }
}
